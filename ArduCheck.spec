        'msilib',
        'mmap',
        'nis',
        'nis',
    ],
    noarchive=False,
    optimize=1,  # Nivel 1 = eliminar assert y __debug__
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='ArduCheck',
    debug=False,
    bootloader_ignore_signals=False,
    strip=True,           # Strip símbolos de depuración
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=None,
)
